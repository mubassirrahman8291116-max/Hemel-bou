<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>BOU CHASE RUN</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#75d5ff;font-family:system-ui,Arial,sans-serif}
canvas{position:fixed;inset:0;width:100%;height:100%}
#hud{position:fixed;z-index:5;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;align-items:flex-start;color:#fff;pointer-events:none}
.card{background:rgba(20,24,30,.78);border:2px solid rgba(255,255,255,.35);border-radius:16px;padding:6px 10px;text-align:center;min-width:76px;box-shadow:0 5px 18px #0005}
.card b{font-size:18px}.card small{display:block;font-size:10px;color:#dce7ef}
#barBox{position:fixed;z-index:5;top:70px;left:50%;transform:translateX(-50%);width:min(430px,58vw);text-align:center;color:#fff;text-shadow:0 2px 4px #000}
#bar{height:12px;border-radius:20px;background:#171717aa;border:1px solid #fff8;overflow:hidden}
#fill{height:100%;width:0%;background:linear-gradient(90deg,#ffe600,#ff7b00);transition:width .18s}
#jump{position:fixed;right:18px;bottom:18px;z-index:8;width:112px;height:112px;border-radius:50%;border:4px solid white;background:linear-gradient(#ffb800,#ff6a00);color:#fff;font-size:19px;font-weight:1000;box-shadow:0 8px 25px #0007;text-shadow:0 2px 3px #000}
#jump:active{transform:scale(.94)}
#sound{position:fixed;z-index:8;right:10px;top:68px;border:0;border-radius:12px;background:#111b;color:white;padding:8px;font-size:18px}
.overlay{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:linear-gradient(#06101a77,#06101add);padding:18px}
.hidden{display:none!important}
.panel{width:min(430px,94vw);background:linear-gradient(180deg,#18222b,#0c1116);color:#fff;border:2px solid #ffffff30;border-radius:24px;padding:25px;text-align:center;box-shadow:0 20px 70px #000}
.title{font-size:38px;font-weight:1000;color:#ffe000;text-shadow:0 4px #8b4700;letter-spacing:1px}
.sub{color:#d9e0e5}
.btn{width:100%;padding:15px;margin-top:12px;border:0;border-radius:15px;background:linear-gradient(135deg,#ffe000,#ff7200);font-size:18px;font-weight:1000;color:#1b1200}
#levelPop{font-size:38px;font-weight:1000;color:#65ff75;text-shadow:0 3px #174e20}
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="hud">
  <div class="card"><small>SCORE</small><b id="score">0</b></div>
  <div class="card"><small>LEVEL</small><b id="level">1</b></div>
  <div class="card"><small>OBJECT</small><b id="obj">0/5</b></div>
</div>
<div id="barBox"><b id="lv">LEVEL 1</b><div id="bar"><div id="fill"></div></div><small id="remain">৫টি object পার করো</small></div>
<button id="sound">🔊</button>
<button id="jump">⬆<br>JUMP</button>

<div id="startScreen" class="overlay">
  <div class="panel">
    <div class="title">BOU CHASE RUN</div>
    <div class="sub">একবার শুরু করলে বউ তোমাকে ছাড়বে না! 😈</div>
    <div style="font-size:52px;margin:12px">🏃‍♂️💨   😈</div>
    <p>শুধু JUMP চাপবে। সামনে আসা বাধা পার করবে। প্রতি ৫টি obstacle পার হলে নতুন Level!</p>
    <button class="btn" id="start">▶ START GAME</button>
  </div>
</div>

<div id="levelScreen" class="overlay hidden">
  <div class="panel"><div id="levelPop">LEVEL UP! ⭐</div><h2 id="levelNumber">LEVEL 2</h2></div>
</div>

<div id="gameOver" class="overlay hidden">
  <div class="panel">
    <div class="title" style="color:#ff4b4b;text-shadow:0 4px #620000">GAME OVER</div>
    <div style="font-size:56px">😂💀</div>
    <p>বউ তোমাকে ধরে ফেলেছে!</p>
    <p>Score: <b id="finalScore">0</b> • Level: <b id="finalLevel">1</b></p>
    <button class="btn" id="restart">↻ TRY AGAIN</button>
  </div>
</div>

<script>
const PLAYER_HEAD="data:image/png;base64,";
const BOU_HEAD="data:image/png;base64,";
const START_VOICE="data:audio/mpeg;base64,";

const canvas=document.getElementById("c"),ctx=canvas.getContext("2d");
const pimg=new Image(),cimg=new Image();pimg.src=PLAYER_HEAD;cimg.src=BOU_HEAD;
let W=innerWidth,H=innerHeight,dpr=1;
let playing=false,dead=false,last=0,time=0;
let score=0,level=1,passed=0,target=5,speed=360,spawnT=.7,chase=210;
let player={x:0,y:0,r:48,vy:0,ground:true};
let bou={x:0,y:0,r:45},obs=[],dust=[];
let muted=false,voice=null;

function resize(){
 dpr=Math.min(2,devicePixelRatio||1);W=innerWidth;H=innerHeight;
 canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+"px";canvas.style.height=H+"px";
 ctx.setTransform(dpr,0,0,dpr,0,0);
 player.x=W*.31; player.r=Math.max(38,Math.min(60,W*.065)); player.y=ground()-player.r*2.0;
}
function ground(){return H*.80}
addEventListener("resize",resize);

function beep(kind){
 if(muted)return;
 try{
  window.audioCtx ||= new (window.AudioContext||window.webkitAudioContext)();
  const a=window.audioCtx,o=a.createOscillator(),g=a.createGain(),n=a.currentTime;
  o.connect(g);g.connect(a.destination);
  if(kind==="jump"){o.frequency.setValueAtTime(440,n);o.frequency.exponentialRampToValueAtTime(850,n+.12)}
  else if(kind==="level"){o.frequency.setValueAtTime(520,n);o.frequency.setValueAtTime(780,n+.12);o.frequency.setValueAtTime(1040,n+.24)}
  else{o.type="sawtooth";o.frequency.setValueAtTime(220,n);o.frequency.exponentialRampToValueAtTime(55,n+.55)}
  g.gain.setValueAtTime(.001,n);g.gain.exponentialRampToValueAtTime(.18,n+.02);g.gain.exponentialRampToValueAtTime(.001,n+(kind==="over"?.6:.42));
  o.start(n);o.stop(n+(kind==="over"?.61:.43));
 }catch(e){}
}
document.getElementById("sound").onclick=()=>{muted=!muted;document.getElementById("sound").textContent=muted?"🔇":"🔊"};

function playVoice(){
 if(!voice_b64_exists())return;
 try{voice=new Audio(START_VOICE);voice.volume=.9;voice.play().catch(()=>{});}catch(e){}
}
function voice_b64_exists(){return START_VOICE.length>40}

function reset(){
 score=0;level=1;passed=0;target=5;speed=360;spawnT=.8;chase=220;obs=[];dust=[];dead=false;
 resize();hud();
}
function startGame(){
 document.getElementById("startScreen").classList.add("hidden");
 document.getElementById("gameOver").classList.add("hidden");
 reset();playing=true;last=performance.now();playVoice();requestAnimationFrame(loop);
}
document.getElementById("start").onclick=startGame;
document.getElementById("restart").onclick=startGame;

function jump(){
 if(!playing||dead||!player.ground)return;
 player.vy=-Math.min(980,H*1.28);player.ground=false;beep("jump");
 for(let i=0;i<8;i++)dust.push({x:player.x+Math.random()*35-18,y:ground()-4,vx:Math.random()*80-40,vy:-Math.random()*160-50,l:.45});
}
document.getElementById("jump").onpointerdown=e=>{e.preventDefault();jump()};
addEventListener("keydown",e=>{if(e.code==="Space"||e.code==="ArrowUp"){e.preventDefault();jump()}});

function spawn(){
 const types=[["box",58,58],["rock",72,42],["barrel",48,60],["cone",45,62]];
 const q=types[Math.floor(Math.random()*types.length)];
 obs.push({x:W+80,y:ground()-q[2],w:q[1],h:q[2],type:q[0],count:false,hit:false});
}
function collision(o){
 const px=player.x,py=player.y+player.r;
 return px+player.r*.45>o.x-o.w/2&&px-player.r*.45<o.x+o.w/2&&py>o.y+8&&player.y<o.y+o.h;
}
function levelUp(){
 level++;target=level*5;speed+=48;chase=Math.min(330,chase+32);
 document.getElementById("levelNumber").textContent="LEVEL "+level;
 document.getElementById("levelScreen").classList.remove("hidden");beep("level");
 setTimeout(()=>document.getElementById("levelScreen").classList.add("hidden"),900);
}
function hud(){
 document.getElementById("score").textContent=Math.floor(score);
 document.getElementById("level").textContent=level;
 document.getElementById("obj").textContent=passed+"/"+target;
 document.getElementById("lv").textContent="LEVEL "+level;
 let base=(level-1)*5,p=passed-base;
 document.getElementById("fill").style.width=Math.min(100,p/5*100)+"%";
 document.getElementById("remain").textContent=Math.max(0,target-passed)+"টি object বাকি";
}
function over(){
 if(dead)return;dead=true;playing=false;beep("over");
 document.getElementById("finalScore").textContent=Math.floor(score);
 document.getElementById("finalLevel").textContent=level;
 document.getElementById("gameOver").classList.remove("hidden");
}
function update(dt){
 time+=dt;score+=dt*(10+level*2);
 player.y+=player.vy*dt;player.vy+=2450*dt;
 if(player.y>=ground()-player.r*2){player.y=ground()-player.r*2;player.vy=0;player.ground=true}
 spawnT-=dt;if(spawnT<=0){spawn();spawnT=Math.max(.58,1.28-level*.04)*(0.72+Math.random()*.45)}
 for(const o of obs){
   o.x-=speed*dt;
   if(!o.count&&!o.hit&&o.x+o.w/2<player.x-player.r){o.count=true;passed++;if(passed>=target)levelUp()}
   if(!o.hit&&collision(o)){
      o.hit=true;chase-=105;
      if(chase<=0)over();
   }
 }
 obs=obs.filter(o=>o.x>-120);
 chase=Math.min(340,chase+dt*(3.2+level*.25));
 for(const d of dust){d.x+=d.vx*dt;d.y+=d.vy*dt;d.vy+=400*dt;d.l-=dt}
 dust=dust.filter(d=>d.l>0);hud();
}
function imgHead(img,x,y,r){
 ctx.save();ctx.beginPath();ctx.arc(x,y+r,r,0,Math.PI*2);ctx.clip();ctx.drawImage(img,x-r,y,r*2,r*2);ctx.restore();
}
function body(x,groundY,r,shirt){
 // cartoon torso
 ctx.fillStyle=shirt;ctx.beginPath();ctx.roundRect(x-r*.62,groundY-r*.1,r*1.24,r*1.15,r*.25);ctx.fill();
 // arms
 ctx.strokeStyle=shirt;ctx.lineWidth=Math.max(8,r*.2);ctx.lineCap="round";
 ctx.beginPath();ctx.moveTo(x-r*.48,groundY+r*.05);ctx.lineTo(x-r*.78,groundY+r*.42);ctx.moveTo(x+r*.48,groundY+r*.05);ctx.lineTo(x+r*.78,groundY+r*.42);ctx.stroke();
 // running legs
 ctx.strokeStyle="#18212a";ctx.lineWidth=Math.max(9,r*.22);
 let phase=Math.sin(time*15+(x<player.x?0:Math.PI));
 ctx.beginPath();ctx.moveTo(x-r*.25,groundY+r*.9);ctx.lineTo(x-r*.52+phase*r*.45,groundY+r*1.45);
 ctx.moveTo(x+r*.25,groundY+r*.9);ctx.lineTo(x+r*.50-phase*r*.45,groundY+r*1.42);ctx.stroke();
 // shoes
 ctx.lineWidth=Math.max(7,r*.16);ctx.beginPath();ctx.moveTo(x-r*.52+phase*r*.45,groundY+r*1.45);ctx.lineTo(x-r*.85+phase*r*.45,groundY+r*1.45);ctx.moveTo(x+r*.50-phase*r*.45,groundY+r*1.42);ctx.lineTo(x+r*.82-phase*r*.45,groundY+r*1.42);ctx.stroke();
}
function cartoonChar(img,x,r,shirt,isBou=false){
 const gy=ground()-r*.02;
 body(x,gy,r,shirt);
 imgHead(img,x,gy-r*2.05,r);
 // name tag above chaser
 if(isBou){
   ctx.font="1000 "+Math.max(15,r*.42)+"px Arial";ctx.textAlign="center";
   ctx.lineWidth=6;ctx.strokeStyle="#fff";ctx.strokeText("বউ",x,gy-r*2.45);
   ctx.fillStyle="#ff2f68";ctx.fillText("বউ",x,gy-r*2.45);
 }
}
function background(){
 let g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#65cfff");g.addColorStop(.58,"#b9f0ff");g.addColorStop(1,"#ffe5a9");ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 // clouds
 ctx.fillStyle="#ffffffaa";
 for(let i=0;i<6;i++){let x=((i*210-time*10)% (W+250))-120,y=90+(i%3)*45;ctx.beginPath();ctx.arc(x,y,28,0,7);ctx.arc(x+35,y-10,38,0,7);ctx.arc(x+70,y,25,0,7);ctx.fill()}
 // hills
 ctx.fillStyle="#65ad5d";ctx.beginPath();ctx.moveTo(0,H*.53);for(let x=0;x<=W;x+=70)ctx.lineTo(x,H*.47+Math.sin(x*.012)*28);ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.fill();
 // distant buildings
 for(let i=0;i<9;i++){let x=i*120-(time*speed*.08%120);ctx.fillStyle=i%2?"#e7a56e":"#d9835e";ctx.fillRect(x,H*.35,70,H*.3);ctx.fillStyle="#8bd3ef";ctx.fillRect(x+10,H*.39,18,24);ctx.fillRect(x+40,H*.39,18,24)}
 // ground
 ctx.fillStyle="#7b5534";ctx.fillRect(0,ground(),W,H-ground());ctx.fillStyle="#55a83c";ctx.fillRect(0,ground()-8,W,8);
 // lane marks
 ctx.fillStyle="#e8d19a";for(let x=-40;x<W+50;x+=90){let xx=x-(time*speed*.65%90);ctx.fillRect(xx,ground()+45,48,6)}
}
function drawObs(o){
 ctx.save();ctx.translate(o.x,o.y);
 if(o.type==="box"){ctx.fillStyle="#a65d2c";ctx.fillRect(-o.w/2,0,o.w,o.h);ctx.strokeStyle="#efb16c";ctx.lineWidth=4;ctx.strokeRect(-o.w/2+3,3,o.w-6,o.h-6);ctx.beginPath();ctx.moveTo(-o.w/2,0);ctx.lineTo(o.w/2,o.h);ctx.moveTo(o.w/2,0);ctx.lineTo(-o.w/2,o.h);ctx.stroke()}
 else if(o.type==="rock"){ctx.fillStyle="#6b6e6a";ctx.beginPath();ctx.ellipse(0,o.h*.55,o.w/2,o.h*.55,0,0,7);ctx.fill()}
 else if(o.type==="barrel"){ctx.fillStyle="#c04e32";ctx.fillRect(-o.w/2,0,o.w,o.h);ctx.fillStyle="#2d3032";ctx.fillRect(-o.w/2,8,o.w,7);ctx.fillRect(-o.w/2,o.h-15,o.w,7)}
 else{ctx.fillStyle="#ff9d1e";ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(o.w/2,o.h);ctx.lineTo(-o.w/2,o.h);ctx.closePath();ctx.fill();ctx.fillStyle="#fff";ctx.fillRect(-o.w*.25,o.h*.48,o.w*.5,7)}
 ctx.restore();
}
function draw(){
 background();
 // chaser is always visible, following behind player
 const bx=player.x-chase;
 cartoonChar(cimg,bx,bou.r,"#b30f64",true);
 for(const o of obs)drawObs(o);
 cartoonChar(pimg,player.x,player.r,"#1f6fbe",false);
 for(const d of dust){ctx.globalAlpha=Math.max(0,d.l*2);ctx.fillStyle="#fff2d0";ctx.beginPath();ctx.arc(d.x,d.y,4,0,7);ctx.fill()}ctx.globalAlpha=1;
 if(chase<90){ctx.fillStyle="rgba(255,0,0,.14)";ctx.fillRect(0,0,W,H)}
}
function loop(now){if(!playing)return;let dt=Math.min(.032,(now-last)/1000);last=now;update(dt);draw();requestAnimationFrame(loop)}
resize();draw();
</script>
</body>
</html>
